
# ===============================================================================
# CONFIGURAÇÕES AMBIENTAIS — APISIX GATEWAY MANAGEMENT PLATFORM
# ===============================================================================

# Certificados SSL / TLS Corporativo
REQUESTS_CA_BUNDLE="api/certificates/corp-ca.pem"

# Configurações do Servidor Flask
LOGGER_LEVEL="INFO"
FLASK_ENV="development"
FLASK_APP="apisix-gateway-manager"
FLASK_HOST="0.0.0.0"
FLASK_PORT=8080
FLASK_VAULT=""
FLASK_KEY_VAULT="30c5cc21e52e791b017c816ecb0ed65f2101fe4f574ffc1891ced4c47fd85e5c"

# ==============================================================================
# APISIX GATEWAY — Instâncias (multi-instance)
# ==============================================================================
# Instâncias são gerenciadas via UI e armazenadas no banco de dados.
# As variáveis abaixo definem a instância padrão (fallback).

# URL da Admin API da instância APISIX padrão
APISIX_DEFAULT_ADMIN_URL="http://127.0.0.1:9180"

# API Key de autenticação (header X-API-KEY) da instância padrão
APISIX_DEFAULT_ADMIN_KEY="edd1c9f034335f136f87ad84b625c8f1"

# Nome/label da instância padrão
APISIX_DEFAULT_INSTANCE_NAME="Local Development"

# Ambientes a monitorar (separados por vírgula)
APISIX_ENVIRONMENTS="DEV,HML,PRD"

# TTL do cache de respostas da Admin API em segundos (3600 = 1 hora, 0 = desativado)
APISIX_CACHE_TTL_SECONDS=3600

# ==============================================================================
# OIDC / SSO Corporativo — Azure AD (Entra ID)
# ==============================================================================
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_TENANT_ID=""
OIDC_ISSUER_URL=""
# Discovery endpoint (preenchido automaticamente se OIDC_TENANT_ID estiver configurado)
# https://login.microsoftonline.com/{tenant_id}/v2.0/.well-known/openid-configuration

# ==============================================================================
# CONTROLE DE ACESSO (ACL) — GitLab ou arquivo local
# ==============================================================================
GIT_HOST="https://gitlab.example.com"
PROJECT_PATH_ENCODED="api_team%2Fapisix%2Fgovernanca%2Fcontrole"
FILE_NAME="allowed_user_dashportal.json"
BRANCH="main"
GIT_ID_VAULT=""

# Banco de Dados Local
DATABASE_NAME="database.db"

# Notificações (opcional)
GOOGLE_CHAT_WEBHOOK=""

ADMIN_EMAILS=admin@local.com